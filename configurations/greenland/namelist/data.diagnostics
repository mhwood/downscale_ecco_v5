  frequency(8) = 2592000.,
#
 fields(1:11,9) = 'EXFpreci','EXFevap ','EXFroff ','EXFswnet','EXFlwnet','EXFatemp','EXFaqh  ','EXFtaux ','EXFtauy ','EXFuwind','EXFvwind',
  fileName(9) = 'diags/exf_day_mean/exf_day_mean',
