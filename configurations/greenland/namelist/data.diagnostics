  frequency(3) = 86400.,
  levels(1:2,3) = 1,
#
  fields(1:3,4) = 'UVEL    ','VVEL    ','WVEL    ',
  fileName(4) = 'diags/vel_surf_day_mean/vel_surf_day_mean',
  frequency(4) = 86400.,
  levels(1:3,4) = 1,
#
  fields(1:2,5) = 'THETA   ','SALT    ',
  fileName(5) = 'diags/state_AW_day_mean/state_AW_day_mean',
  frequency(5) = 86400.,
  levels(1:2,5) = 31,
#
  fields(1:3,6) = 'UVEL    ','VVEL    ','WVEL    ',
  fileName(6) = 'diags/vel_AW_day_mean/vel_AW_day_mean',
  frequency(6) = 86400.,
  levels(1:3,6) = 31,
#
  fields(1:2,7) = 'THETA   ','SALT    ',
  fileName(7) = 'diags/state_3D_mon_mean/state_3D_mon_mean',
  frequency(7) = 2592000.,
#
  fields(1:3,8) = 'UVEL    ','VVEL    ','WVEL    ',
